{
  "manifest_version": 3,
  "name": "Job Radar Capture",
  "version": "1.0",
  "description": "Adds a Capture button to job pages and saves each job into its own numbered folder in Downloads.",
  "permissions": ["downloads", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Job Radar Capture" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
